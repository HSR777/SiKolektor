<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_home_root">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingBottom="90dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingTop="22dp"
            android:paddingEnd="28dp"
            android:paddingBottom="110dp">

            <!-- HEADER -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="Absen Masuk"
                    android:textColor="@color/primary"
                    android:textSize="22sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- CARD WAKTU -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="96dp"
                android:layout_marginTop="26dp"
                android:background="@drawable/bg_detail_card"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="WAKTU SEKARANG"
                        android:textColor="@color/neutral"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="88dp"
                        android:layout_height="26dp"
                        android:background="@drawable/bg_status_gps"
                        android:gravity="center"
                        android:text="GPS VALID"
                        android:textColor="@color/secondary"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="15:52:09"
                    android:textColor="@color/primary"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⌖  Bandung, Jawa Barat"
                    android:textColor="@color/primary"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- SELFIE BOX -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="280dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_selfie_box"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="14dp">

                <ImageView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:src="@drawable/add_a_photo"
                    android:tint="@color/neutral" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Posisikan wajah Anda di dalam kotak"
                    android:textColor="@color/neutral"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/btnAmbilFoto"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="42dp"
                    android:background="@drawable/bg_outline_green"
                    android:gravity="center"
                    android:text="AMBIL FOTO"
                    android:textColor="@color/secondary"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- CATATAN -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Catatan Opsional"
                android:textColor="#061B26"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etCatatanAbsen"
                android:layout_width="match_parent"
                android:layout_height="78dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_text_area"
                android:gravity="top"
                android:hint="Masukkan keterangan lapangan (opsional)..."
                android:inputType="textMultiLine"
                android:padding="14dp"
                android:textColor="@color/neutral"
                android:textColorHint="#9AAAB5"
                android:textSize="12sp" />

            <!-- TOMBOL ABSEN MASUK -->
            <TextView
                android:id="@+id/btnAbsenMasuk"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="36dp"
                android:background="@drawable/bg_primary_button"
                android:gravity="center"
                android:text="SIMPAN"
                android:textColor="@color/white"
                android:textSize="22sp"
                android:textStyle="bold" />

        </LinearLayout>
    </ScrollView>

    <!-- BOTTOM NAVIGATION -->
    <LinearLayout
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_gravity="bottom"
        android:background="#EAF7FF"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <!-- HOME TIDAK AKTIF -->
        <LinearLayout
            android:id="@+id/navHome"
            android:layout_width="72dp"
            android:layout_height="56dp"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/home_icon"
                android:tint="@color/neutral" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Home"
                android:textColor="@color/neutral"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>
        

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- KUNJUNGAN -->
        <LinearLayout
            android:id="@+id/navKunjungan"
            android:layout_width="88dp"
            android:layout_height="56dp"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/kunjungan_icon"
                android:tint="@color/neutral" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kunjungan"
                android:textColor="@color/neutral"
                android:textSize="10sp" />
        </LinearLayout>

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- HISTORY -->
        <LinearLayout
            android:id="@+id/navHistory"
            android:layout_width="72dp"
            android:layout_height="56dp"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/history_24"
                android:tint="@color/neutral" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="History"
                android:textColor="@color/neutral"
                android:textSize="10sp" />
        </LinearLayout>

    </LinearLayout>

</FrameLayout>