<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_home_root">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingBottom="90dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingTop="24dp"
            android:paddingEnd="28dp"
            android:paddingBottom="110dp">

            <!-- HEADER -->
            <LinearLayout
                android:id="@+id/layoutHeaderHistory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/imgProfile"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_profile_image"
                    android:gravity="center"
                    android:text="👤"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tvMainClock"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:text="22:43:15"
                    android:textColor="@color/primary"
                    android:textSize="23sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSmallClock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="08:45:12"
                    android:textColor="@color/primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- SEARCH -->
            <EditText
                android:id="@+id/etSearchHistory"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="28dp"
                android:background="@drawable/bg_search_box"
                android:drawableStart="@android:drawable/ic_menu_search"
                android:drawablePadding="10dp"
                android:hint="Cari Nama Nasabah..."
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:singleLine="true"
                android:textColor="@color/neutral"
                android:textColorHint="#B4C0C9"
                android:textSize="13sp" />

            <!-- CARD 1 BERHASIL -->
            <LinearLayout
                android:id="@+id/cardHistoryOne"
                android:layout_width="match_parent"
                android:layout_height="92dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_history_card_success"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="16dp"
                android:paddingBottom="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Nasabah"
                            android:textColor="@color/neutral"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tvHistoryNameOne"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Toko Maju Jaya"
                            android:textColor="#061B26"
                            android:textSize="18sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvStatusOne"
                        android:layout_width="82dp"
                        android:layout_height="26dp"
                        android:background="@drawable/bg_badge_success"
                        android:gravity="center"
                        android:text="✓ Berhasil"
                        android:textColor="@color/secondary"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="58dp"
                        android:layout_height="wrap_content"
                        android:text="◷ 09:15"
                        android:textColor="#061B26"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="⌖  Jl. Merdeka No. 12"
                        android:textColor="#061B26"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- CARD 2 RUMAH KOSONG -->
            <LinearLayout
                android:id="@+id/cardHistoryTwo"
                android:layout_width="match_parent"
                android:layout_height="92dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_history_card_warning"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="16dp"
                android:paddingBottom="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Nasabah"
                            android:textColor="@color/neutral"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tvHistoryNameTwo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Bpk. Slamet"
                            android:textColor="#061B26"
                            android:textSize="18sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvStatusTwo"
                        android:layout_width="102dp"
                        android:layout_height="26dp"
                        android:background="@drawable/bg_badge_warning"
                        android:gravity="center"
                        android:text="● Rumah Kosong"
                        android:textColor="#6B2D00"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="58dp"
                        android:layout_height="wrap_content"
                        android:text="◷ 10:30"
                        android:textColor="#061B26"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="⌖  Komp. Graha Indah B-4"
                        android:textColor="#061B26"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- CARD 3 BERHASIL -->
            <LinearLayout
                android:id="@+id/cardHistoryThree"
                android:layout_width="match_parent"
                android:layout_height="92dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_history_card_success"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="16dp"
                android:paddingBottom="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Nasabah"
                            android:textColor="@color/neutral"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tvHistoryNameThree"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ibu Siti"
                            android:textColor="#061B26"
                            android:textSize="18sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvStatusThree"
                        android:layout_width="82dp"
                        android:layout_height="26dp"
                        android:background="@drawable/bg_badge_success"
                        android:gravity="center"
                        android:text="✓ Berhasil"
                        android:textColor="@color/secondary"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="58dp"
                        android:layout_height="wrap_content"
                        android:text="◷ 11:45"
                        android:textColor="#061B26"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="⌖  Pasar Baru Blok A-12"
                        android:textColor="#061B26"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- BOTTOM NAVIGATION -->
    <LinearLayout
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_gravity="bottom"
        android:background="#EAF7FF"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <!-- HOME TIDAK AKTIF -->
        <LinearLayout
            android:id="@+id/navHome"
            android:layout_width="72dp"
            android:layout_height="56dp"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⌂"
                android:textColor="@color/neutral"
                android:textSize="20sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Home"
                android:textColor="@color/neutral"
                android:textSize="10sp" />
        </LinearLayout>

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- KUNJUNGAN TIDAK AKTIF -->
        <LinearLayout
            android:id="@+id/navKunjungan"
            android:layout_width="88dp"
            android:layout_height="56dp"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▣"
                android:textColor="@color/neutral"
                android:textSize="20sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kunjungan"
                android:textColor="@color/neutral"
                android:textSize="10sp" />
        </LinearLayout>

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />


        <!-- HISTORY AKTIF -->
        <LinearLayout
            android:id="@+id/navHistory"
            android:layout_width="72dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_bottom_nav_active"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/baseline_history_24"
                android:tint="@color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="History"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:textStyle="bold" />

        </LinearLayout>
    </LinearLayout>

</FrameLayout>